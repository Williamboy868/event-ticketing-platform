// use prisma-8

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  @@type("pg/text@1")
  PARTICIPANT = "PARTICIPANT"
  ORGANIZER   = "ORGANIZER"
  ADMIN       = "ADMIN"
}

enum EventStatus {
  @@type("pg/text@1")
  UPCOMING  = "UPCOMING"
  ONGOING   = "ONGOING"
  COMPLETED = "COMPLETED"
  CANCELLED = "CANCELLED"
}

enum OrderStatus {
  @@type("pg/text@1")
  PENDING   = "PENDING"
  PAID      = "PAID"
  CANCELLED = "CANCELLED"
}

enum PaymentStatus {
  @@type("pg/text@1")
  PENDING    = "PENDING"
  SUCCESSFUL = "SUCCESSFUL"
  FAILED     = "FAILED"
}

enum TicketStatus {
  @@type("pg/text@1")
  ACTIVE  = "ACTIVE"
  SCANNED = "SCANNED"
}

model User {
  id         String @id @default(uuid()) @db.Uuid
  first_name String
  last_name  String
  email      String @unique
  password   String
  role       Role   @default(PARTICIPANT)

  organized_events Event[] @relation("OrganizedEvents")
  orders           Order[] @relation("PlacedOrders")
}

model Event {
  id                  String      @id @default(uuid()) @db.Uuid
  organizer_id        String      @db.Uuid
  name                String
  description         String
  start_time          DateTime
  end_time            DateTime
  discount_percentage Float       @default(0.0)
  status              EventStatus @default(UPCOMING)

  organizer         User             @relation("OrganizedEvents", fields: [organizer_id], references: [id])
  ticket_categories TicketCategory[]
  orders            Order[]
}

model TicketCategory {
  id       String @id @default(uuid()) @db.Uuid
  event_id String @db.Uuid
  name     String // e.g., VIP, General
  price    Float
  capacity Int

  event   Event    @relation(fields: [event_id], references: [id])
  tickets Ticket[]
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  participant_id String      @db.Uuid
  event_id       String      @db.Uuid
  total_amount   Float
  status         OrderStatus @default(PENDING)

  participant User     @relation("PlacedOrders", fields: [participant_id], references: [id])
  event       Event    @relation(fields: [event_id], references: [id])
  payment     Payment?
  tickets     Ticket[]
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  order_id       String        @unique @db.Uuid
  payment_method String
  amount         Float
  status         PaymentStatus @default(PENDING)

  order Order @relation(fields: [order_id], references: [id])
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  order_id     String       @db.Uuid
  category_id  String       @db.Uuid
  qr_code_data String       @unique
  status       TicketStatus @default(ACTIVE)

  order    Order          @relation(fields: [order_id], references: [id])
  category TicketCategory @relation(fields: [category_id], references: [id])
}
